---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Menu from "../components/menu.astro";
---

<Layout>
    <div class="flex min-h-screen text-slate-900">
        <Menu />
        <main class="min-w-0 flex-1 bg-blue-50 p-8 pb-12" id="inicio">
            <header class="mb-7 flex items-center justify-between text-sm text-slate-500">
                <div class="flex items-center gap-2"><span class="size-2 rounded-full bg-emerald-500 ring-4 ring-emerald-100"></span> Panel de control <span class="text-slate-400">/</span> Inicio</div>
                
            </header>

            <section class="relative flex min-h-40 justify-between overflow-hidden rounded-xl border border-blue-200 bg-linear-to-br from-white via-white to-blue-100 px-10 py-8 shadow-lg shadow-blue-900/10" aria-labelledby="dashboard-title">
                <div><p class="mb-2 text-[10px] font-semibold tracking-widest text-blue-700">BIENVENIDO, GABRIEL</p><h1 class="mb-2 text-3xl font-medium tracking-tight text-slate-900" id="dashboard-title">Resumen de la producción</h1><p class="m-0 text-xs text-slate-600">Aquí tienes una vista general del estado de tus órdenes, talleres y producción.</p></div>
                <div class="z-10 mr-20 grid size-16 rotate-[-7deg] place-items-center self-center rounded-xl bg-blue-700 text-3xl text-white shadow-xl shadow-blue-700/30" aria-hidden="true"><i class="fa-solid fa-chart-simple"></i></div>
            </section>

            <section class="my-4 grid grid-cols-5 gap-3.5" aria-label="Indicadores de producción">
                <article class="min-h-40 rounded-xl border border-blue-100 bg-white p-5 shadow-md shadow-blue-900/5"><div class="mb-4 grid size-9 place-items-center rounded-lg bg-blue-100 text-blue-700"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i></div><p class="mb-2 text-xs text-slate-600">Órdenes activas</p><strong class="mb-2 block text-3xl leading-none text-slate-900">0</strong><span class="text-[10px] text-slate-500"><i class="fa-solid fa-minus"></i> Sin registros todavía</span></article>
                <article class="min-h-40 rounded-xl border border-blue-100 bg-white p-5 shadow-md shadow-blue-900/5"><div class="mb-4 grid size-9 place-items-center rounded-lg bg-cyan-100 text-cyan-700"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i></div><p class="mb-2 text-xs text-slate-600">Cumplimiento de plazos</p><strong class="mb-2 block text-3xl leading-none text-slate-900">0%</strong><span class="text-[10px] text-slate-500"><i class="fa-solid fa-minus"></i> Sin registros todavía</span></article>
                <article class="min-h-40 rounded-xl border border-blue-100 bg-white p-5 shadow-md shadow-blue-900/5"><div class="mb-4 grid size-9 place-items-center rounded-lg bg-violet-100 text-violet-700"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></div><p class="mb-2 text-xs text-slate-600">Unidades producidas</p><strong class="mb-2 block text-3xl leading-none text-slate-900">0</strong><span class="text-[10px] text-slate-500"><i class="fa-solid fa-minus"></i> Sin registros todavía</span></article>
                <article class="min-h-40 rounded-xl border border-blue-100 bg-white p-5 shadow-md shadow-blue-900/5"><div class="mb-4 grid size-9 place-items-center rounded-lg bg-rose-100 text-rose-700"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></div><p class="mb-2 text-xs text-slate-600">Prendas con defectos</p><strong class="mb-2 block text-3xl leading-none text-slate-900">0</strong><span class="text-[10px] text-slate-500"><i class="fa-solid fa-minus"></i> Sin registros todavía</span></article>
                <article class="min-h-40 rounded-xl border border-blue-100 bg-white p-5 shadow-md shadow-blue-900/5"><div class="mb-4 grid size-9 place-items-center rounded-lg bg-emerald-100 text-emerald-700"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i></div><p class="mb-2 text-xs text-slate-600">Capacidad ocupada</p><strong class="mb-2 block text-3xl leading-none text-slate-900">0%</strong><div class="mt-2 grid gap-1.5 text-[10px] text-slate-600"><span>Propia <b class="ml-1 inline-block h-1 w-16 rounded bg-slate-200"><i class="block h-full w-0 rounded bg-blue-600"></i></b> 0%</span><span>Externa <b class="ml-1 inline-block h-1 w-16 rounded bg-slate-200"><i class="block h-full w-0 rounded bg-blue-600"></i></b> 0%</span></div></article>
            </section>

            <section class="grid grid-cols-[minmax(0,1fr)_390px] gap-5">
                <article class="min-h-[410px] rounded-xl border border-blue-100 bg-white p-6 shadow-md shadow-blue-900/5"><div class="mb-5 flex items-center justify-between"><div><p class="mb-2 text-[10px] font-semibold tracking-widest text-blue-700">SEGUIMIENTO</p><h2 class="text-lg font-medium text-slate-900">Órdenes de producción</h2></div><button class="cursor-pointer border-0 bg-transparent text-sm text-blue-700" type="button">Ver todas <i class="fa-solid fa-arrow-right ml-1"></i></button></div><div class="empty-table flex min-h-[315px] flex-col items-center justify-center rounded-lg border border-dashed border-slate-200 bg-slate-50 text-center"><div class="mb-4 grid size-14 place-items-center rounded-xl bg-blue-50 text-2xl text-blue-400"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i></div><h3 class="mb-1 text-sm font-medium text-slate-900">Aún no hay órdenes de producción</h3><p class="mb-5 text-sm text-slate-400">Cuando registres una orden, su avance aparecerá aquí.</p><button class="new-order-button cursor-pointer rounded-lg border-0 bg-blue-700 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-700/25" type="button"><i class="fa-solid fa-plus mr-2"></i> Nueva orden de producción</button></div></article>
                <aside><article class="min-h-[410px] rounded-xl border border-blue-100 bg-white p-6 shadow-md shadow-blue-900/5"><div class="mb-5 flex items-center justify-between"><h2 class="text-lg font-medium text-slate-900"><i class="fa-regular fa-bell mr-2 text-blue-700"></i> Alertas</h2><span class="grid size-8 place-items-center rounded-full bg-blue-100 text-sm font-medium text-blue-700">0</span></div><div class="flex min-h-80 flex-col items-center justify-center text-center text-sm text-slate-500"><i class="fa-regular fa-circle-check mb-3 text-4xl text-emerald-500"></i><strong class="mb-1 text-lg font-medium text-slate-700">Todo está en orden</strong><span>No hay alertas pendientes.</span></div></article></aside>
            </section>
        </main>
    </div>

    <dialog class="fixed left-1/2 top-1/2 m-0 max-h-[calc(100vh-28px)] w-[720px] max-w-[calc(100%-28px)] -translate-x-1/2 -translate-y-1/2 rounded-xl border-0 p-0 text-slate-900 shadow-2xl shadow-blue-950/35" id="order-dialog" aria-labelledby="order-dialog-title">
        <form class="max-h-[calc(100vh-28px)] overflow-y-auto p-7" id="order-form">
            <div class="mb-6 flex items-start justify-between"><div><p class="mb-2 text-[10px] font-extrabold tracking-widest text-blue-700">REGISTRO DE PRODUCCIÓN</p><h2 class="text-xl font-bold">Nueva orden de producción</h2></div><button class="close-dialog cursor-pointer border-0 bg-transparent text-lg text-slate-600" type="button" aria-label="Cerrar formulario"><i class="fa-solid fa-xmark"></i></button></div>
            <div class="grid grid-cols-2 gap-4 text-xs font-bold text-slate-700">
                <label class="flex flex-col gap-2">Orden de Producción <input class="w-full rounded-md border border-blue-200 p-3 font-normal outline-blue-600" name="orderNumber" id="order-number" readonly required placeholder="Selecciona una prenda" /></label>
                <label class="flex flex-col gap-2">Tipo de Prenda <select class="w-full rounded-md border border-blue-200 bg-white p-3 font-normal outline-blue-600" name="garmentType" id="garment-type" required><option value="">Selecciona una prenda</option><option>Camisa</option><option>Blusa</option><option>Pantalón</option><option>Casacas</option><option>Short</option><option>Bermuda</option><option>T shirt</option><option>Polo box</option></select></label>
                <label class="flex flex-col gap-2">Género <select class="w-full rounded-md border border-blue-200 bg-white p-3 font-normal outline-blue-600" name="gender" id="garment-gender" required><option value="">Selecciona un género</option><option>Mujer</option><option>Hombre</option></select></label>
                <label class="flex flex-col gap-2">Tipo de tela <input class="w-full rounded-md border border-blue-200 p-3 font-normal outline-blue-600" name="fabricType" required placeholder="Ej. Denim, algodón" /></label>
                <label class="flex flex-col gap-2">Composición <input class="w-full rounded-md border border-blue-200 p-3 font-normal outline-blue-600" name="composition" required placeholder="Ej. 98% algodón, 2% elastano" /></label>
                <label class="flex flex-col gap-2">Modelo <input class="w-full rounded-md border border-blue-200 p-3 font-normal outline-blue-600" name="model" required placeholder="Nombre o referencia" /></label>
                <label class="flex flex-col gap-2">Cantidad <input class="w-full rounded-md border border-blue-200 p-3 font-normal outline-blue-600" name="quantity" type="number" min="1" required placeholder="0" /></label>
                <label class="flex flex-col gap-2">Curva <input class="w-full rounded-md border border-blue-200 p-3 font-normal outline-blue-600" name="curve" required placeholder="Ej. XS: 10, S: 20, M: 30" /></label>
                <label class="flex flex-col gap-2">Ancho de Tela <input class="w-full rounded-md border border-blue-200 p-3 font-normal outline-blue-600" name="fabricWidth" required placeholder="Ej. 1.60 m" /></label>
                <label class="flex flex-col gap-2">Taller <select class="w-full rounded-md border border-blue-200 bg-white p-3 font-normal outline-blue-600" name="workshopId" id="workshop-select" required><option value="">Selecciona un taller</option></select></label>
                <label class="wash-field hidden flex-col gap-2">Tipo de lavado <input class="w-full rounded-md border border-blue-200 p-3 font-normal outline-blue-600" name="washType" placeholder="Ej. Stone wash" /></label>
            </div>
            <fieldset class="mt-5 rounded-lg border border-blue-200 p-4"><legend class="px-2 text-sm font-extrabold">Seguimiento de la producción</legend><p class="mb-4 text-[11px] text-slate-500">Define el avance inicial desde patronaje y establece el rizado de acuerdo a la curva.</p><div class="grid grid-cols-4 gap-3 text-xs font-bold text-slate-700"><label class="flex min-h-11 items-center justify-center gap-2 rounded-md border border-blue-200 px-2"><input class="accent-blue-700" name="patternmaking" type="checkbox" /> Patronaje</label><label class="flex flex-col gap-2">Rizado según curva <input class="w-full rounded-md border border-blue-200 p-3 font-normal outline-blue-600" name="gathering" placeholder="Ej. 1.5 x la curva" /></label><label class="flex min-h-11 items-center justify-center gap-2 rounded-md border border-blue-200 px-2"><input class="accent-blue-700" name="sewing" type="checkbox" /> Confección</label><label class="flex min-h-11 items-center justify-center gap-2 rounded-md border border-blue-200 px-2"><input class="accent-blue-700" name="finishing" type="checkbox" /> Acabados</label></div></fieldset>
            <div class="mt-6 flex justify-end gap-3"><button class="close-dialog cursor-pointer rounded-lg border border-blue-200 bg-white px-4 py-3 text-sm font-semibold text-slate-600" type="button">Cancelar</button><button class="cursor-pointer rounded-lg border-0 bg-blue-700 px-5 py-3 text-sm font-semibold text-white" type="submit"><i class="fa-solid fa-check mr-2"></i> Crear orden</button></div>
        </form>
    </dialog>
</Layout>

<style>
    dialog::backdrop { background: rgb(9 39 72 / 65%); backdrop-filter: blur(4px); }
</style>
